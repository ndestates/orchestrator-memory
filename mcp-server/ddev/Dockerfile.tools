# DDEV web image layer — host-style CLI tools for agents (ripgrep, etc.).
#
# Install (app repo):
#   mkdir -p .ddev/web-build
#   cp mcp-server/ddev/Dockerfile.tools .ddev/web-build/Dockerfile.tools
#   ddev restart
#
# Prefer config when enough (no custom Dockerfile):
#   # .ddev/config.yaml
#   webimage_extra_packages: [ripgrep]
#   # then: ddev restart
#
# Can stack with Dockerfile.mcp in the same web-build/ directory.

ARG BASE_IMAGE
FROM $BASE_IMAGE

USER root
RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
      apt-get update \
      && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ripgrep \
      && apt-get clean \
      && rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
      apk add --no-cache ripgrep; \
    else \
      echo "WARN: no apt/apk — install ripgrep manually in this image" >&2; \
    fi
