# DDEV web image layer — orchestrator MCP Python dependencies + CLI tools (ripgrep).
# Install: cp mcp-server/ddev/Dockerfile.mcp → .ddev/web-build/Dockerfile.mcp
# Then: ddev restart
#
# venv-aware: projects with /opt/venv (e.g. jerseyhouseprices) get mcp in the venv PATH.
# For tools-only (no MCP), prefer webimage_extra_packages: [ripgrep] or Dockerfile.tools.

ARG BASE_IMAGE
FROM $BASE_IMAGE

USER root
RUN set -eux; \
    if command -v apt-get >/dev/null 2>&1; then \
      apt-get update \
       && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
            ripgrep \
            python3-pip \
       && apt-get clean \
       && rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
      apk add --no-cache ripgrep; \
    fi; \
    if [ -x /opt/venv/bin/pip ]; then \
      /opt/venv/bin/pip install --no-cache-dir "mcp[cli]>=1.2.0" "pyyaml>=6.0"; \
    else \
      pip3 install --no-cache-dir --break-system-packages --ignore-installed \
            "mcp[cli]>=1.2.0" "pyyaml>=6.0" || \
      python3 -m pip install --no-cache-dir --break-system-packages --ignore-installed \
            "mcp[cli]>=1.2.0" "pyyaml>=6.0"; \
    fi